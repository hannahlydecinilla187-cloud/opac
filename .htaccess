# OPAC — Apache (XAMPP) rewrite rules.
# Mirrors vercel.json: one front controller (api/index.php) for every
# pretty URL; REQUEST_URI keeps the original path for the router.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------------------
    # Block direct browser requests into /api/ (raw PHP sources).
    # THE_REQUEST is the ORIGINAL client request line and is NOT changed
    # by the internal rewrite below, so only real /api URLs are blocked.
    # Mirrors vercel.json's "/api/(.*) -> /" redirect.
    # ------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s[^?#]*/api(/|\?|\s)
    RewriteRule ^ - [F]

    # Root must be routed BEFORE the -f/-d pass-through below, otherwise
    # "/" falls through to mod_dir (directory index / listing).
    RewriteRule ^$ api/index.php [L,QSA]

    # Serve existing files/directories directly (assets, offline edition).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else -> single front controller (like the Vercel catch-all).
    RewriteRule ^(.*)$ api/index.php [L,QSA]
</IfModule>
