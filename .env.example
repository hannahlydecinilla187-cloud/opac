# ---- Local development (XAMPP) ----
# Leave everything unset to use XAMPP defaults below:
#   mysql host=127.0.0.1 port=3306 db=opac user=root (no password)
#
# Or set a full URL / PDO DSN, e.g.:
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/opac
# DATABASE_URL=mysql:host=127.0.0.1;port=3306;dbname=opac;charset=utf8mb4

# DATABASE_URL=

# ---- Production: Railway MySQL ----
# On Vercel set either DATABASE_URL (Railway's PUBLIC URL from the MySQL
# service's "Connect" tab) …
# DATABASE_URL=mysql://user:password@caboo.proxy.rlwy.net:51047/railway
#
# … or Railway's variables directly (public host/port required — the private
# mysql.railway.internal host is unreachable from Vercel):
# MYSQL_PUBLIC_HOST=caboo.proxy.rlwy.net
# MYSQL_PUBLIC_PORT=51047
# MYSQLUSER=root
# MYSQLPASSWORD=change-me
# MYSQLDATABASE=railway
#
# (Plain MYSQLHOST / MYSQLPORT also work if you paste the PUBLIC values there.)

# Secret used to sign the admin session cookie. Change this!
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: force the app's base path, e.g. APP_BASE=/OPAC
# APP_BASE=
