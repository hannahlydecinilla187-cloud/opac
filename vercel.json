{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "redirects": [
    { "source": "/api/(.*)", "destination": "/" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
